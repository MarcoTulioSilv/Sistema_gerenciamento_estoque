# ============================================================
# SCE — Configuração de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# ============================================================

# ─── Banco de dados MySQL ───────────────────────────────────
DB_HOST=192.168.1.100        # IP ou hostname do servidor MySQL
DB_PORT=3306
DB_NAME=sce_db
DB_USER=sce_app
DB_PASSWORD=SenhaForte@2025

# Pool de conexões SQLAlchemy
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ─── Segurança ──────────────────────────────────────────────
# Chave Fernet para criptografia do App Password Gmail.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Aplicação ──────────────────────────────────────────────
APP_VERSION=1.0.0
APP_DEBUG=false
SESSION_TIMEOUT_MIN=30       # minutos de inatividade antes de expirar sessão

# ─── Dashboard ──────────────────────────────────────────────
DASHBOARD_REFRESH_SEC=30     # intervalo de atualização do T-22
