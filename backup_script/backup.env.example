# ============================================================
# backup_script — Configuração do backup automático do servidor
# Copie este arquivo para "backup.env" (nesta mesma pasta) e
# preencha os valores reais. NUNCA commite o backup.env.
# ============================================================

# ─── Conexão MySQL ───────────────────────────────────────────
# Usuário dedicado de menor privilégio — ver criar_usuario_backup.sql.
# Este script roda NO PRÓPRIO SERVIDOR (192.168.0.150), por isso
# 127.0.0.1/localhost é o valor recomendado para DB_HOST.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sce_db
DB_USER=sce_backup
DB_PASSWORD=

# ─── Destino dos backups ─────────────────────────────────────
# Caminho LOCAL de disco (NÃO use \\192.168.0.150\... aqui).
# Como este script roda no mesmo host que hospeda o compartilhamento
# "SCE_Updates", use o caminho de disco local que o Windows compartilha
# sob esse nome — acesso via UNC ao próprio host (loopback) costuma
# falhar por restrição de segurança do SMB no Windows.
# Exemplo: se a pasta compartilhada "SCE_Updates" fica fisicamente em
# D:\Compartilhado\SCE_Updates, aponte para uma subpasta dedicada nela:
BACKUP_DIR=D:\Compartilhado\SCE_Updates\Backups_SCE

# ─── Retenção e timeout ──────────────────────────────────────
# Dias para manter backups antes de apagar automaticamente.
# 0 ou negativo = nunca apagar automaticamente.
RETENCAO_DIAS=30

# Timeout do mysqldump, em segundos.
TIMEOUT_SEGUNDOS=600

# ─── mysqldump ────────────────────────────────────────────────
# Por padrão usa "mysqldump" (depende do PATH). A tarefa agendada roda
# como SYSTEM, que tem PATH próprio e pode não enxergar o mysqldump mesmo
# que ele funcione no seu usuário interativo (mesmo problema que já
# aconteceu com o python.exe — ver instalar_tarefa.bat). Se o backup
# falhar com "Comando 'mysqldump' não encontrado no PATH do servidor",
# descomente e ajuste a linha abaixo para o caminho completo:
# MYSQLDUMP_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
